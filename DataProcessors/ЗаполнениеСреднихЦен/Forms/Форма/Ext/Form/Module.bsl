#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КаталогОбмена = ОбработкаОбъект.КаталогОбменаПоУмолчанию();
	ИмяФайлаЗапроса = ОбработкаОбъект.ИмяФайлаЗапроса();
	ИмяСигналаЗапроса = ОбработкаОбъект.ИмяСигналаЗапроса();
	ИмяФайлаОтвета = ОбработкаОбъект.ИмяФайлаОтвета();
	ИмяСигналаОтвета = ОбработкаОбъект.ИмяСигналаОтвета();
	СтатусОбмена = НСтр("ru = 'Ожидание отправки запроса.'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодготовитьКаталогОбменаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьОтветИИ");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьАвтомобили(Команда)
	
	СобратьАвтомобилиНаСервере();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Автомобили'"),
		,
		СтрШаблон(НСтр("ru = 'Собрано строк: %1'"), Автомобили.Количество()));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДляИИ(Команда)
	
	Если Автомобили.Количество() = 0 Тогда
		СобратьАвтомобилиНаСервере();
	КонецЕсли;
	
	Если Автомобили.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Справочник автомобилей пуст. Заполните справочник и повторите отправку.'"));
		Возврат;
	КонецЕсли;
	
	ОтправитьЗапросИИНаСервере();
	ПодключитьОбработчикОжидания("ПроверитьОтветИИ", 3);
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Обмен с ИИ'"),
		,
		НСтр("ru = 'Запрос записан в exchange. Сигнал: request.signal'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦеныИИ(Команда)
	
	Если ЗабратьОтветИИНаСервере() Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтветИИ");
		ПоказатьОповещениеПользователя(НСтр("ru = 'Обмен с ИИ'"), , СтатусОбмена);
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(, НСтр("ru = 'Нет сигнала ответа в папке exchange. Дождитесь файла response.signal.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВРегистр(Команда)
	
	КоличествоЗаписей = ЗаписатьВРегистрНаСервере();
	
	Если КоличествоЗаписей = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк со средней ценой для записи. Сначала загрузите ответ ИИ.'"));
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Средние цены'"),
		,
		СтрШаблон(НСтр("ru = 'Записано строк: %1'"), КоличествоЗаписей));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьОтветИИ()
	
	Если Не ЗабратьОтветИИНаСервере() Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьОтветИИ");
	ПоказатьОповещениеПользователя(НСтр("ru = 'Обмен с ИИ'"), , СтатусОбмена);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьКаталогОбменаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПодготовитьКаталогОбмена(КаталогОбмена);
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьЗапросИИНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	ТекстJson = ОбработкаОбъект.JsonДанныхДляПоискаЦен(ТаблицаАвтомобилей);
	ОбработкаОбъект.ОтправитьЗапросЦен(КаталогОбмена, ТекстJson);
	СтатусОбмена = НСтр("ru = 'Сигнал отправлен. Ожидание цен от ИИ...'");
	
КонецПроцедуры

&НаСервере
Функция ЗабратьОтветИИНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатЧтения = ОбработкаОбъект.ПрочитатьОтветИИ(КаталогОбмена);
	
	Если Не РезультатЧтения.ЕстьОтвет Тогда
		Если ЗначениеЗаполнено(РезультатЧтения.ОписаниеОшибки) Тогда
			СтатусОбмена = РезультатЧтения.ОписаниеОшибки;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если Автомобили.Количество() = 0 Тогда
		ТаблицаАвтомобилей = ОбработкаОбъект.ТаблицаАвтомобилей();
	Иначе
		ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	КонецЕсли;
	
	КоличествоЦен = ОбработкаОбъект.ПрименитьЦеныИзJson(ТаблицаАвтомобилей, РезультатЧтения.ТекстJson);
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	КоличествоЗаписей = ОбработкаОбъект.ЗаписатьСредниеЦены(ТаблицаАвтомобилей);
	ОбработкаОбъект.ЗавершитьОбмен(КаталогОбмена);
	
	СтатусОбмена = СтрШаблон(
		НСтр("ru = 'Цены загружены: %1. Записано в регистр: %2.'"),
		КоличествоЦен,
		КоличествоЗаписей);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СобратьАвтомобилиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = ОбработкаОбъект.ТаблицаАвтомобилей();
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьВРегистрНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	Возврат ОбработкаОбъект.ЗаписатьСредниеЦены(ТаблицаАвтомобилей);
	
КонецФункции

#КонецОбласти
