#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьАвтомобили(Команда)
	
	СобратьАвтомобилиНаСервере();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Автомобили'"),
		,
		СтрШаблон(НСтр("ru = 'Собрано строк: %1'"), Автомобили.Количество()));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДляИИ(Команда)
	
	Если Автомобили.Количество() = 0 Тогда
		СобратьАвтомобилиНаСервере();
	КонецЕсли;
	
	Если Автомобили.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Справочник автомобилей пуст.'"));
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.ПолноеИмяФайла = "cars-request.json";
	Диалог.Фильтр = НСтр("ru = 'JSON (*.json)|*.json'");
	Диалог.Заголовок = НСтр("ru = 'Сохранить данные автомобилей для поиска цен'");
	Диалог.Показать(Новый ОписаниеОповещения("ВыгрузитьДляИИЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦеныИИ(Команда)
	
	Если Автомобили.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала соберите автомобили.'"));
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = НСтр("ru = 'JSON (*.json)|*.json'");
	Диалог.Заголовок = НСтр("ru = 'Выберите JSON с ценами от ИИ'");
	Диалог.Показать(Новый ОписаниеОповещения("ЗагрузитьЦеныИИЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВРегистр(Команда)
	
	КоличествоЗаписей = ЗаписатьВРегистрНаСервере();
	
	Если КоличествоЗаписей = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк со средней ценой для записи.'"));
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Средние цены'"),
		,
		СтрШаблон(НСтр("ru = 'Записано строк: %1'"), КоличествоЗаписей));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыгрузитьДляИИЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстJson = JsonДанныхДляПоискаЦенНаСервере();
	ЗаписьТекста = Новый ЗаписьТекста(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстJson);
	ЗаписьТекста.Закрыть();
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Выгрузка для ИИ'"),
		,
		НСтр("ru = 'Файл сохранен. Передайте его в Cursor для поиска цен на avito.ru и auto.ru.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦеныИИЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеТекста = Новый ЧтениеТекста(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	ТекстJson = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	КоличествоЦен = ПрименитьЦеныИзJsonНаСервере(ТекстJson);
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Цены ИИ'"),
		,
		СтрШаблон(НСтр("ru = 'Заполнено цен: %1'"), КоличествоЦен));
	
КонецПроцедуры

&НаСервере
Процедура СобратьАвтомобилиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = ОбработкаОбъект.ТаблицаАвтомобилей();
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	
КонецПроцедуры

&НаСервере
Функция JsonДанныхДляПоискаЦенНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	Возврат ОбработкаОбъект.JsonДанныхДляПоискаЦен(ТаблицаАвтомобилей);
	
КонецФункции

&НаСервере
Функция ПрименитьЦеныИзJsonНаСервере(ТекстJson)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	КоличествоЦен = ОбработкаОбъект.ПрименитьЦеныИзJson(ТаблицаАвтомобилей, ТекстJson);
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	
	Возврат КоличествоЦен;
	
КонецФункции

&НаСервере
Функция ЗаписатьВРегистрНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	Возврат ОбработкаОбъект.ЗаписатьСредниеЦены(ТаблицаАвтомобилей);
	
КонецФункции

#КонецОбласти
