#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КаталогОбмена = ОбработкаОбъект.КаталогОбменаПоУмолчанию();
	ИмяФайлаЗапроса = ОбработкаОбъект.ИмяФайлаЗапроса();
	ИмяСигналаЗапроса = ОбработкаОбъект.ИмяСигналаЗапроса();
	ИмяФайлаОтвета = ОбработкаОбъект.ИмяФайлаОтвета();
	ИмяСигналаОтвета = ОбработкаОбъект.ИмяСигналаОтвета();
	СтатусОбмена = НСтр("ru = 'Ожидание отправки запроса.'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодготовитьКаталогОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьОтветИИ");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьАвтомобили(Команда)
	
	СобратьАвтомобилиНаСервере();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Автомобили'"),
		,
		СтрШаблон(НСтр("ru = 'Собрано строк: %1'"), Автомобили.Количество()));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДляИИ(Команда)
	
	Если Автомобили.Количество() = 0 Тогда
		СобратьАвтомобилиНаСервере();
	КонецЕсли;
	
	Если Автомобили.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Справочник автомобилей пуст.'"));
		Возврат;
	КонецЕсли;
	
	ПодготовитьКаталогОбмена();
	ОтправитьЗапросИИ();
	ПодключитьОбработчикОжидания("ПроверитьОтветИИ", 3);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦеныИИ(Команда)
	
	Если Не ЗабратьОтветИИ() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет сигнала ответа в папке exchange. Дождитесь файла response.signal.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВРегистр(Команда)
	
	КоличествоЗаписей = ЗаписатьВРегистрНаСервере();
	
	Если КоличествоЗаписей = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк со средней ценой для записи.'"));
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Средние цены'"),
		,
		СтрШаблон(НСтр("ru = 'Записано строк: %1'"), КоличествоЗаписей));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьОтветИИ()
	
	Если ЗабратьОтветИИ() Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтветИИ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗапросИИ()
	
	ТекстJson = JsonДанныхДляПоискаЦенНаСервере();
	ЗаписатьТекстВФайл(ПутьФайлаЗапроса(), ТекстJson);
	
	УдалитьФайлЕслиСуществует(ПутьФайлаОтвета());
	УдалитьФайлЕслиСуществует(ПутьСигналаОтвета());
	ЗаписатьТекстВФайл(ПутьСигналаЗапроса(), "PRICE_REQUEST");
	
	СтатусОбмена = НСтр("ru = 'Сигнал отправлен. Ожидание цен от ИИ...'");
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Обмен с ИИ'"),
		,
		НСтр("ru = 'Запрос записан в exchange. Сигнал: request.signal'"));
	
КонецПроцедуры

&НаКлиенте
Функция ЗабратьОтветИИ()
	
	ФайлСигнала = Новый Файл(ПутьСигналаОтвета());
	Если Не ФайлСигнала.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФайлОтвета = Новый Файл(ПутьФайлаОтвета());
	Если Не ФайлОтвета.Существует() Тогда
		СтатусОбмена = НСтр("ru = 'Есть сигнал ответа, но файл цен не найден.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если Автомобили.Количество() = 0 Тогда
		СобратьАвтомобилиНаСервере();
	КонецЕсли;
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьФайлаОтвета(), КодировкаТекста.UTF8);
	ТекстJson = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	КоличествоЦен = ПрименитьЦеныИзJsonНаСервере(ТекстJson);
	КоличествоЗаписей = ЗаписатьВРегистрНаСервере();
	
	УдалитьФайлЕслиСуществует(ПутьСигналаОтвета());
	УдалитьФайлЕслиСуществует(ПутьСигналаЗапроса());
	
	СтатусОбмена = СтрШаблон(
		НСтр("ru = 'Цены загружены: %1. Записано в регистр: %2.'"),
		КоличествоЦен,
		КоличествоЗаписей);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Обмен с ИИ'"), , СтатусОбмена);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПодготовитьКаталогОбмена()
	
	Если Не ЗначениеЗаполнено(КаталогОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогНаДиске = Новый Файл(КаталогОбмена);
	Если КаталогНаДиске.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьКаталог(КаталогОбмена);
	
КонецПроцедуры

&НаКлиенте
Функция КаталогОбменаСоСлешем()
	
	Если Не ЗначениеЗаполнено(КаталогОбмена) Тогда
		Возврат "";
	КонецЕсли;
	
	ПоследнийСимвол = Прав(КаталогОбмена, 1);
	Если ПоследнийСимвол = "\" Или ПоследнийСимвол = "/" Тогда
		Возврат КаталогОбмена;
	КонецЕсли;
	
	Возврат КаталогОбмена + "\";
	
КонецФункции

&НаКлиенте
Функция ПутьФайлаЗапроса()
	
	Возврат КаталогОбменаСоСлешем() + ИмяФайлаЗапроса;
	
КонецФункции

&НаКлиенте
Функция ПутьСигналаЗапроса()
	
	Возврат КаталогОбменаСоСлешем() + ИмяСигналаЗапроса;
	
КонецФункции

&НаКлиенте
Функция ПутьФайлаОтвета()
	
	Возврат КаталогОбменаСоСлешем() + ИмяФайлаОтвета;
	
КонецФункции

&НаКлиенте
Функция ПутьСигналаОтвета()
	
	Возврат КаталогОбменаСоСлешем() + ИмяСигналаОтвета;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьТекстВФайл(ПутьФайла, ТекстФайла)
	
	ЗаписьТекста = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстФайла);
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлЕслиСуществует(ПутьФайла)
	
	ФайлНаДиске = Новый Файл(ПутьФайла);
	Если Не ФайлНаДиске.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьФайлы(ПутьФайла);
	
КонецПроцедуры

&НаСервере
Процедура СобратьАвтомобилиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = ОбработкаОбъект.ТаблицаАвтомобилей();
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	
КонецПроцедуры

&НаСервере
Функция JsonДанныхДляПоискаЦенНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	Возврат ОбработкаОбъект.JsonДанныхДляПоискаЦен(ТаблицаАвтомобилей);
	
КонецФункции

&НаСервере
Функция ПрименитьЦеныИзJsonНаСервере(ТекстJson)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	КоличествоЦен = ОбработкаОбъект.ПрименитьЦеныИзJson(ТаблицаАвтомобилей, ТекстJson);
	ЗначениеВРеквизитФормы(ТаблицаАвтомобилей, "Автомобили");
	
	Возврат КоличествоЦен;
	
КонецФункции

&НаСервере
Функция ЗаписатьВРегистрНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаАвтомобилей = РеквизитФормыВЗначение("Автомобили");
	Возврат ОбработкаОбъект.ЗаписатьСредниеЦены(ТаблицаАвтомобилей);
	
КонецФункции

#КонецОбласти
