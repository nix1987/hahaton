#Область ПрограммныйИнтерфейс

// Обходит все элементы справочника Автомобили и записывает среднюю цену
// в регистр сведений СредниеЦены на текущую дату сеанса.
//
// Возвращаемое значение:
//  Число - количество записанных строк регистра.
//
Функция ЗаполнитьСредниеЦены() Экспорт
	
	ГенераторСлучайныхЧисел = Новый ГенераторСлучайныхЧисел;
	ПериодЗаписи = ТекущаяДатаСеанса();
	КоличествоЗаписей = 0;
	
	ВыборкаАвтомобилей = Справочники.Автомобили.Выбрать();
	Пока ВыборкаАвтомобилей.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.СредниеЦены.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ПериодЗаписи;
		МенеджерЗаписи.Автомобиль = ВыборкаАвтомобилей.Ссылка;
		МенеджерЗаписи.СредняяЦена = СлучайнаяСредняяЦена(ГенераторСлучайныхЧисел);
		МенеджерЗаписи.Записать();
		
		КоличествоЗаписей = КоличествоЗаписей + 1;
		
	КонецЦикла;
	
	Возврат КоличествоЗаписей;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СлучайнаяСредняяЦена(ГенераторСлучайныхЧисел)
	
	МинимальнаяЦена = 800000;
	МаксимальнаяЦена = 1200000;
	ШагЦены = 10000;
	КоличествоШагов = (МаксимальнаяЦена - МинимальнаяЦена) / ШагЦены;
	
	Возврат МинимальнаяЦена + ГенераторСлучайныхЧисел.СлучайноеЧисло(0, КоличествоШагов) * ШагЦены;
	
КонецФункции

#КонецОбласти
