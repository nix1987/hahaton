#Область ОбработчикиHTTPСервиса

// Возвращает JSON со случайной записью регистра СредниеЦены.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ПолучитьСлучайнуюСреднююЦену(Запрос)
	
	ДанныеОтвета = СлучайнаяЗаписьСреднихЦен();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СлучайнаяЗаписьСреднихЦен()
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("Автомобиль", "");
	ДанныеОтвета.Вставить("СредняяЦена", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СредниеЦены.Автомобиль КАК Автомобиль,
	|	СредниеЦены.СредняяЦена КАК СредняяЦена
	|ИЗ
	|	РегистрСведений.СредниеЦены КАК СредниеЦены";
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	КоличествоЗаписей = ТаблицаЗаписей.Количество();
	Если КоличествоЗаписей = 0 Тогда
		Возврат ДанныеОтвета;
	КонецЕсли;
	
	Генератор = Новый ГенераторСлучайныхЧисел;
	ИндексЗаписи = Генератор.СлучайноеЧисло(0, КоличествоЗаписей - 1);
	СтрокаЗаписи = ТаблицаЗаписей[ИндексЗаписи];
	
	ДанныеОтвета.Автомобиль = Строка(СтрокаЗаписи.Автомобиль);
	ДанныеОтвета.СредняяЦена = СтрокаЗаписи.СредняяЦена;
	
	Возврат ДанныеОтвета;
	
КонецФункции

#КонецОбласти
