	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ОперацииПоАвтомобилям</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Автомобиль</dataPath>
			<field>Автомобиль</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаДоходов</dataPath>
			<field>СуммаДоходов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаРасходов</dataPath>
			<field>СуммаРасходов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаПродажи</dataPath>
			<field>СуммаПродажи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма продажи</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОперацииСАвто.Автомобиль КАК Автомобиль
ПОМЕСТИТЬ ВТАвтомобили
ИЗ
	РегистрСведений.ОперацииСАвто КАК ОперацииСАвто

СГРУППИРОВАТЬ ПО
	ОперацииСАвто.Автомобиль

ИНДЕКСИРОВАТЬ ПО
	Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОперацииСАвто.Автомобиль КАК Автомобиль,
	СУММА(ОперацииСАвто.Сумма) КАК СуммаДоходов
ПОМЕСТИТЬ ВТДоходы
ИЗ
	РегистрСведений.ОперацииСАвто КАК ОперацииСАвто
ГДЕ
	ОперацииСАвто.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипОпераци.Доход)

СГРУППИРОВАТЬ ПО
	ОперацииСАвто.Автомобиль

ИНДЕКСИРОВАТЬ ПО
	Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОперацииСАвто.Автомобиль КАК Автомобиль,
	СУММА(ОперацииСАвто.Сумма) КАК СуммаРасходов
ПОМЕСТИТЬ ВТРасходы
ИЗ
	РегистрСведений.ОперацииСАвто КАК ОперацииСАвто
ГДЕ
	ОперацииСАвто.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипОпераци.Расход)

СГРУППИРОВАТЬ ПО
	ОперацииСАвто.Автомобиль

ИНДЕКСИРОВАТЬ ПО
	Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СредниеЦеныСрезПоследних.Автомобиль КАК Автомобиль,
	СредниеЦеныСрезПоследних.СредняяЦена КАК СредняяЦена
ПОМЕСТИТЬ ВТЦены
ИЗ
	РегистрСведений.СредниеЦены.СрезПоследних(, ) КАК СредниеЦеныСрезПоследних

ИНДЕКСИРОВАТЬ ПО
	Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТАвтомобили.Автомобиль КАК Автомобиль,
	ЕСТЬNULL(ВТДоходы.СуммаДоходов, 0) КАК СуммаДоходов,
	ЕСТЬNULL(ВТРасходы.СуммаРасходов, 0) КАК СуммаРасходов,
	ЕСТЬNULL(ВТЦены.СредняяЦена, 0) КАК СуммаПродажи
ИЗ
	ВТАвтомобили КАК ВТАвтомобили
		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоходы КАК ВТДоходы
		ПО ВТАвтомобили.Автомобиль = ВТДоходы.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ ВТРасходы КАК ВТРасходы
		ПО ВТАвтомобили.Автомобиль = ВТРасходы.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК ВТЦены
		ПО ВТАвтомобили.Автомобиль = ВТЦены.Автомобиль</query>
	</dataSet>
	<calculatedField>
		<dataPath>Рентабельность</dataPath>
		<expression>Окр(ВЫБОР КОГДА СуммаРасходов = 0 ТОГДА 0 ИНАЧЕ (СуммаДоходов - СуммаРасходов) / СуммаРасходов * 100 КОНЕЦ, 4)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Рентабельность %</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=4</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>15</v8:Digits>
				<v8:FractionDigits>4</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Продаем</dataPath>
		<expression>Окр(ВЫБОР КОГДА СуммаРасходов = 0 ТОГДА 0 ИНАЧЕ (СуммаДоходов - СуммаРасходов) / СуммаРасходов * 100 КОНЕЦ, 4) &lt; 20</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Продаем</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Рентабельность</dataPath>
		<expression>Окр(ВЫБОР КОГДА Сумма(СуммаРасходов) = 0 ТОГДА 0 ИНАЧЕ (Сумма(СуммаДоходов) - Сумма(СуммаРасходов)) / Сумма(СуммаРасходов) * 100 КОНЕЦ, 4)</expression>
	</totalField>
	<totalField>
		<dataPath>Продаем</dataPath>
		<expression>Максимум(Продаем)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаПродажи</dataPath>
		<expression>Сумма(СуммаПродажи)</expression>
	</totalField>
